# Variables d'environnement de la Pages Function du formulaire de contact.
#
# Ce fichier ne sert que de modele : il ne contient aucune valeur reelle et ne
# doit jamais en contenir. En production, ces variables se declarent dans le
# tableau de bord Cloudflare Pages (Settings > Environment variables), en les
# marquant comme secretes. En local, copiez ce fichier vers .dev.vars, qui est
# ignore par git.

# Cle d'API Resend, creee sur https://resend.com/api-keys
RESEND_API_KEY=

# Adresse qui recoit les notifications du formulaire.
CONTACT_TO_EMAIL=

# Adresse expeditrice declaree aupres de Resend. Son domaine doit etre verifie
# dans Resend, sinon l'envoi est refuse.
CONTACT_FROM_EMAIL=
