---
import { getDictionary, format, type Locale } from '../i18n/ui';
import { pathFor } from '../i18n/routes';
import { products } from '../data/products';
import { SITE_NAME } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();

const columns = [
  {
    title: t.products.sectionTitle,
    links: products.map((product) => ({
      label: product.name,
      href: pathFor(product.route, locale),
    })),
  },
  {
    title: t.footer.siteSection,
    links: [
      { label: t.nav.about, href: pathFor('about', locale) },
      { label: t.nav.contact, href: pathFor('contact', locale) },
    ],
  },
  {
    title: t.footer.legalSection,
    links: [
      { label: t.legal.title, href: pathFor('legal', locale) },
      { label: t.privacy.title, href: pathFor('privacy', locale) },
    ],
  },
];
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-base font-bold tracking-tight text-ink">{SITE_NAME}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{t.site.tagline}</p>
      </div>

      {
        columns.map((column) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-ink">{column.title}</h2>
            <ul class="mt-4 space-y-2 text-sm">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-muted transition-colors hover:text-ink hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-12 border-t border-line pt-6 text-xs text-muted">
      {format(t.footer.copyright, { year, siteName: SITE_NAME })}
    </p>
  </div>
</footer>
