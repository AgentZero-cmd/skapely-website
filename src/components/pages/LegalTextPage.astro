---
import Card from '../Card.astro';
import { getDictionary, format, type Locale } from '../../i18n/ui';
import { CONTACT_EMAIL, SITE_NAME } from '../../site.config';

interface Props {
  locale: Locale;
  /** Les deux pages partagent la meme structure : titre, avertissement, sections. */
  kind: 'legal' | 'privacy';
}

const { locale, kind } = Astro.props;
const t = getDictionary(locale);
const content = t[kind];
const values = { siteName: SITE_NAME, email: CONTACT_EMAIL };
---

<!--
  ATTENTION : le contenu de cette page est un squelette. Les marqueurs
  [[A COMPLETER : ...]] doivent etre renseignes, puis l'ensemble relu par un
  professionnel du droit avant la mise en ligne du site.
-->
<section class="mx-auto max-w-3xl px-4 pt-16 pb-8 sm:px-6 sm:pt-24">
  <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">{content.title}</h1>
  <p class="mt-6 rounded-control bg-subtle p-4 text-sm leading-relaxed text-ink">
    {content.disclaimer}
  </p>
</section>

<section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
  <div class="space-y-6">
    {
      content.sections.map((section) => (
        <Card>
          <h2 class="text-lg font-semibold text-ink">{section.title}</h2>
          <p class="mt-3 text-base leading-relaxed text-muted">
            {format(section.body, values)}
          </p>
        </Card>
      ))
    }
  </div>
</section>
