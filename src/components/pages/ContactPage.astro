---
import Card from '../Card.astro';
import ContactForm from '../ContactForm.astro';
import Icon from '../Icon.astro';
import { getDictionary, type Locale } from '../../i18n/ui';
import { CONTACT_EMAIL } from '../../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6 sm:pt-24">
  <div class="max-w-2xl">
    <h1 class="text-4xl font-bold tracking-tight text-balance text-ink sm:text-5xl">
      {t.contact.title}
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">{t.contact.intro}</p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
  <div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <Card>
        <ContactForm locale={locale} />
      </Card>
    </div>

    <aside>
      <Card class="h-full">
        <Icon name="mail" class="h-6 w-6 text-muted" />
        <h2 class="mt-4 text-base font-semibold text-ink">{t.contact.fallback.label}</h2>
        <p class="mt-3 break-words text-base">
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-ink underline hover:no-underline">
            {CONTACT_EMAIL}
          </a>
        </p>
        <p class="mt-4 text-sm leading-relaxed text-muted">{t.contact.fallback.note}</p>
      </Card>
    </aside>
  </div>
</section>
