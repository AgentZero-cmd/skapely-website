---
import Badge from '../Badge.astro';
import Button from '../Button.astro';
import Card from '../Card.astro';
import CompatibilityNote from '../CompatibilityNote.astro';
import FeatureList from '../FeatureList.astro';
import ProductCard from '../ProductCard.astro';
import SectionHeading from '../SectionHeading.astro';
import { products } from '../../data/products';
import { homeValueIcons } from '../../data/home';
import { getDictionary, format, type Locale } from '../../i18n/ui';
import { pathFor, productsAnchor, productsHref } from '../../i18n/routes';
import { SITE_NAME } from '../../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const contactHref = pathFor('contact', locale);
---

<section class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6 sm:pt-24">
  <div class="max-w-3xl">
    <Badge tone="accent">{t.common.statusBadge}</Badge>
    <h1 class="mt-6 text-4xl font-bold tracking-tight text-balance text-ink sm:text-5xl">
      {t.home.hero.title}
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">{t.home.hero.subtitle}</p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button href={contactHref}>{t.home.hero.primaryCta}</Button>
      <Button href={productsHref(locale)} variant="secondary">{t.home.hero.secondaryCta}</Button>
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <SectionHeading title={t.home.value.title} />
  <div class="mt-10">
    <FeatureList items={t.home.value.items} icons={homeValueIcons} columns={3} />
  </div>
</section>

<section id={productsAnchor} class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6">
  <SectionHeading title={t.home.products.title} intro={t.home.products.intro} />
  <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      products.map((product) => (
        <li class="h-full">
          <ProductCard locale={locale} product={product} />
        </li>
      ))
    }
  </ul>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <SectionHeading title={t.compatibility.title} intro={t.home.compatibility.intro} />
  <div class="mt-10">
    <CompatibilityNote locale={locale} />
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <Card class="max-w-3xl">
    <h2 class="text-2xl font-bold tracking-tight text-ink">
      {format(t.home.status.title, { siteName: SITE_NAME })}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-muted">{t.home.status.body}</p>
    <p class="mt-6">
      <a href={contactHref} class="text-sm font-medium text-ink underline hover:no-underline">
        {t.home.status.link}
      </a>
    </p>
  </Card>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <Card class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <h2 class="text-2xl font-bold tracking-tight text-ink">{t.home.cta.title}</h2>
      <p class="mt-3 text-base leading-relaxed text-muted">{t.home.cta.body}</p>
    </div>
    <Button href={contactHref} class="shrink-0">{t.home.cta.button}</Button>
  </Card>
</section>
