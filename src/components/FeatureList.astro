---
import Card from './Card.astro';
import IconTile from './IconTile.astro';
import type { IconName } from '../data/icons';

interface Props {
  items: readonly { title: string; text: string }[];
  /** Icones alignees par index sur `items`; `check` sert de repli. */
  icons: readonly IconName[];
  columns?: 2 | 3;
}

const { items, icons, columns = 2 } = Astro.props;

const gridClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
} as const;
---

<ul class={`grid gap-6 ${gridClass[columns]}`}>
  {
    items.map((item, index) => (
      <li class="h-full">
        <Card class="h-full">
          <IconTile name={icons[index] ?? 'check'} />
          <h3 class="mt-5 text-base font-semibold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
        </Card>
      </li>
    ))
  }
</ul>
