---
import Card from './Card.astro';
import Icon from './Icon.astro';
import IconTile from './IconTile.astro';
import { getDictionary, type Locale } from '../i18n/ui';
import { pathFor } from '../i18n/routes';
import type { Product } from '../data/products';

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const t = getDictionary(locale);
const item = t.products.items[product.id];
const href = pathFor(product.route, locale);
---

<Card class="flex h-full flex-col">
  <IconTile name={product.icon} />
  <h3 class="mt-5 text-lg font-semibold text-ink">
    <a href={href} class="hover:underline">{product.name}</a>
  </h3>
  <p class="mt-1 text-sm font-medium text-muted">{item.tagline}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{item.summary}</p>
  <p class="mt-6">
    <a
      href={href}
      class="inline-flex items-center gap-2 text-sm font-medium text-ink hover:underline"
      aria-label={`${t.common.learnMore} — ${product.name}`}
    >
      {t.common.learnMore}
      <Icon name="arrowRight" class="h-4 w-4" />
    </a>
  </p>
</Card>
