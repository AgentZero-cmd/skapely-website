---
interface Props {
  /** `accent` est la seule zone verte permanente d'une page : un badge au plus. */
  tone?: 'accent' | 'neutral';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const tones = {
  accent: 'bg-accent-soft text-accent-strong',
  neutral: 'bg-subtle text-muted',
} as const;
---

<span
  class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${tones[tone]} ${className}`}
>
  <slot />
</span>
