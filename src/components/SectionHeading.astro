---
interface Props {
  title: string;
  intro?: string;
  id?: string;
}

const { title, intro, id } = Astro.props;
---

<div class="max-w-2xl">
  <h2 id={id} class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{title}</h2>
  {intro && <p class="mt-4 text-base leading-relaxed text-muted">{intro}</p>}
</div>
