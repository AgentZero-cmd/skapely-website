---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalTextPage from '../../components/pages/LegalTextPage.astro';
import { getDictionary, format } from '../../i18n/ui';
import { SITE_NAME } from '../../site.config';

const locale = 'en' as const;
const t = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  pageId="privacy"
  title={format(t.meta.privacy.title, { siteName: SITE_NAME })}
  description={format(t.meta.privacy.description, { siteName: SITE_NAME })}
>
  <LegalTextPage locale={locale} kind="privacy" />
</BaseLayout>
