---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormStatusPage from '../../../components/pages/FormStatusPage.astro';
import { getDictionary, format } from '../../../i18n/ui';
import { SITE_NAME } from '../../../site.config';

const locale = 'en' as const;
const t = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  pageId="contactError"
  title={format(t.meta.contactError.title, { siteName: SITE_NAME })}
  description={format(t.meta.contactError.description, { siteName: SITE_NAME })}
>
  <FormStatusPage locale={locale} state="error" />
</BaseLayout>
