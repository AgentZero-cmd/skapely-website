---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormStatusPage from '../../components/pages/FormStatusPage.astro';
import { getDictionary, format } from '../../i18n/ui';
import { SITE_NAME } from '../../site.config';

const locale = 'fr' as const;
const t = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  pageId="contactSuccess"
  title={format(t.meta.contactSuccess.title, { siteName: SITE_NAME })}
  description={format(t.meta.contactSuccess.description, { siteName: SITE_NAME })}
>
  <FormStatusPage locale={locale} state="success" />
</BaseLayout>
