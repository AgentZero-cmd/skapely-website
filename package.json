{
  "name": "skapely-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run check:functions && npm run check:i18n",
    "check:functions": "tsc -p functions/tsconfig.json --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "pages:dev": "wrangler pages dev dist --kv RATE_LIMIT_KV"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
